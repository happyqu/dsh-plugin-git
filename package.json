{
  "name": "@happyqu/dsh-plugin-git",
  "version": "0.1.24",
  "description": "Git workbench for deepseek-harness: changelists, staging, history, branches, stashes and optional AI assistance",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "scripts/check-package.mjs",
    "scripts/check-commit.mjs",
    "scripts/check-ai-context.mjs",
    "dist/client.js",
    "scripts/build-client.mjs"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "git",
    "blame",
    "diff"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "release": "node scripts/release.mjs",
    "check": "npm run build && node scripts/check-package.mjs",
    "check:commit": "node scripts/check-commit.mjs",
    "check:ai": "node scripts/check-ai-context.mjs",
    "test": "npm run build && node scripts/check-runtime.mjs && node scripts/check-write-safety.mjs && node scripts/check-worktrees.mjs && node scripts/verify-client.mjs",
    "prepack": "npm run check",
    "build": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyqu/dsh-plugin-git.git"
  },
  "homepage": "https://github.com/happyqu/dsh-plugin-git#readme",
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
