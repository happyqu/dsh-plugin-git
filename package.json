{
  "name": "@happyqu/dsh-plugin-git",
  "version": "0.1.5",
  "description": "Git workbench for deepseek-harness: changelists, staging, history, branches, stashes and optional AI assistance",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "git",
    "blame",
    "diff"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/verify-parse.mjs && node scripts/verify-host.mjs && node scripts/verify-entry.mjs && node scripts/verify-session.mjs && node scripts/verify-client.mjs && node scripts/verify-e2e.mjs",
    "fixture": "node scripts/setup-fixture.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
